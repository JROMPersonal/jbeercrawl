rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /crawls/{crawlId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.breweries is list
                    && request.resource.data.breweries.size() > 0
                    && (request.resource.data.creatorName == null
                        || (request.resource.data.creatorName is string
                            && request.resource.data.creatorName.size() < 100));
      allow update, delete: if request.auth != null;
    }

    match /customBreweries/{breweryId} {
      allow read: if true;
      allow create: if request.resource.data.cityId is string
                    && request.resource.data.cityId.size() > 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 150
                    && (request.resource.data.website_url == null
                        || (request.resource.data.website_url is string
                            && request.resource.data.website_url.size() < 300
                            && request.resource.data.website_url.matches('^https?://.*')))
                    && (request.resource.data.street == null
                        || (request.resource.data.street is string
                            && request.resource.data.street.size() < 200))
                    && (request.resource.data.phone == null
                        || (request.resource.data.phone is string
                            && request.resource.data.phone.size() < 40))
                    && (request.resource.data.addedBy == null
                        || (request.resource.data.addedBy is string
                            && request.resource.data.addedBy.size() < 100));
      allow update, delete: if request.auth != null;
    }

    // Unlike crawls/breweries, cities can only be added by the signed-in
    // admin — not by anonymous visitors. New cities should come from source
    // code (the built-in list) or a deliberate admin action, not a public
    // "+ Add City" button.
    match /customCities/{cityId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.stateAbbr is string
                    && request.resource.data.stateAbbr.size() == 2
                    && (request.resource.data.image == null
                        || (request.resource.data.image is string
                            && request.resource.data.image.size() < 500
                            && request.resource.data.image.matches('^https?://.*')))
                    && (request.resource.data.addedBy == null
                        || (request.resource.data.addedBy is string
                            && request.resource.data.addedBy.size() < 100));
      allow update, delete: if request.auth != null;
    }

    // Shared cache of brewery geocode results (falls back to a free
    // geocoding service when Open Brewery DB has no lat/lng on file) —
    // this is derived/computed data, not user content, so any visitor can
    // both read it and write a new entry. Only the FIRST write per brewery
    // is allowed through (update is admin-only) so one client can't
    // overwrite another's already-cached result.
    match /geocodeCache/{breweryId} {
      allow read: if true;
      allow create: if request.resource.data.position == null
                    || (request.resource.data.position is list
                        && request.resource.data.position.size() == 2
                        && request.resource.data.position[0] is number
                        && request.resource.data.position[0] >= -90
                        && request.resource.data.position[0] <= 90
                        && request.resource.data.position[1] is number
                        && request.resource.data.position[1] >= -180
                        && request.resource.data.position[1] <= 180);
      allow update, delete: if request.auth != null;
    }

    // Reports may contain a reporter's contact email, so unlike everything
    // else in this app, they are NOT publicly readable — only the admin
    // (signed in via Firebase Auth) can view, resolve, or delete them.
    match /reports/{reportId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.type in
                      ['bug', 'update_request', 'removal_request', 'city_request', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 2000
                    && (request.resource.data.about == null
                        || (request.resource.data.about is string
                            && request.resource.data.about.size() < 300))
                    && (request.resource.data.contactEmail == null
                        || (request.resource.data.contactEmail is string
                            && request.resource.data.contactEmail.size() < 200));
    }
  }
}
